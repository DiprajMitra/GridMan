# ==============================================================================
# .dockerignore for GridWise Container Image
# Prevents baking secrets, local virtualenvs, node_modules, and caches into image
# ==============================================================================

# Secrets and environment configurations (NEVER BAKE INTO IMAGE)
.env
.env.*
*.pem
*.key
*.cert
*.id_rsa

# Git and version control
.git
.gitignore
.gitattributes

# Python build artifacts and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
env/
venv/
ENV/

# Frontend node_modules and dev files
frontend/node_modules/
frontend/.vite/
frontend/dist/
*.tsbuildinfo

# IDE and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent logs and temporary storage
brain/
.system_generated/
*.log
tmp/
